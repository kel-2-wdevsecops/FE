# Salin ke .env.local untuk dev lokal. JANGAN commit file .env*.

# Tujuan proxy /api saat `npm run dev` (BE lokal, lihat vite.config.ts).
VITE_DEV_API_TARGET=http://localhost:3008

# Opsional: URL API absolut, hanya kalau FE TIDAK disajikan di origin yang
# sama dengan BE (butuh CORS_ORIGINS di BE). Kosong = /api/v1 (origin sama;
# di produksi diteruskan nginx ke BE).
VITE_API_URL=
